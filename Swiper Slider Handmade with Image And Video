{%- comment -%}
  BV Handmade Slider — centered coverflow gallery (Swiper "coverflow" effect)
  Place in: sections/bv-handmade-slider.liquid
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = 'bvhm-' | append: section.id
  assign can_loop = false
  if s.loop and section.blocks.size >= 5
    assign can_loop = true
  endif
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.css">

{%- style -%}
  #{{ uid }} {
    --bvhm-w: {{ s.slide_width_mobile }}px;
    --bvhm-ratio: {{ s.aspect_ratio }};
    background: {{ s.bg_color }};
    color: {{ s.text_color }};
    padding: {{ s.pad_top_mobile }}px 0 {{ s.pad_bottom_mobile }}px;
    overflow: hidden;
  }
  @media (min-width: 750px) {
    #{{ uid }} { --bvhm-w: {{ s.slide_width }}px; padding: {{ s.pad_top }}px 0 {{ s.pad_bottom }}px; }
  }
  #{{ uid }} .bvhm__heading {
    margin: 0 0 {{ s.heading_gap_mobile }}px;
    padding: 0 16px;
    text-align: {{ s.heading_align }};
    font-size: {{ s.heading_size_mobile }}px;
    font-weight: 400; line-height: 1.3;
    letter-spacing: .02em;
    color: inherit;
  }
  @media (min-width: 750px) {
    #{{ uid }} .bvhm__heading { font-size: {{ s.heading_size }}px; margin-bottom: {{ s.heading_gap }}px; }
  }
  #{{ uid }} .bvhm__icon { margin-right: 10px; }
  #{{ uid }} .bvhm__icon img { height: 1.2em; width: auto; vertical-align: -0.25em; }
  #{{ uid }} .bvhm__slider { position: relative; display: block; }
  #{{ uid }} .swiper { overflow: visible; padding: 10px 0; }
  #{{ uid }} .swiper-wrapper { align-items: center; }
  #{{ uid }} .bvhm__slide { width: var(--bvhm-w); }
  #{{ uid }} .bvhm__media {
    position: relative;
    aspect-ratio: var(--bvhm-ratio);
    overflow: hidden;
    border-radius: {{ s.radius }}px;
    background: #ddd;
    box-shadow: 0 4px 18px rgba(0, 0, 0, {{ s.shadow | divided_by: 100.0 }});
  }
  #{{ uid }} .bvhm__media img,
  #{{ uid }} .bvhm__media video,
  #{{ uid }} .bvhm__media svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  #{{ uid }} .bvhm__media::after {
    content: ""; position: absolute; inset: 0;
    background: #fff; opacity: 0; pointer-events: none;
    transition: opacity .4s;
  }
  {%- if s.dim_sides > 0 -%}
    #{{ uid }} .bvhm__slide:not(.swiper-slide-active) .bvhm__media::after { opacity: {{ s.dim_sides | divided_by: 100.0 }}; }
  {%- endif -%}
  #{{ uid }} .bvhm__arrow {
    position: absolute; z-index: 20; top: 50%;
    transform: translateY(-50%);
    width: 50px; height: 50px;
    border-radius: 50%; border: 0; cursor: pointer;
    background: {{ s.arrow_bg }}; color: {{ s.arrow_color }};
    box-shadow: 0 2px 10px rgba(0, 0, 0, .18);
    display: flex; align-items: center; justify-content: center;
  }
  #{{ uid }} .bvhm__arrow svg { width: 20px; height: 20px; }
  #{{ uid }} .bvhm__arrow--prev { left: 24px; }
  #{{ uid }} .bvhm__arrow--next { right: 24px; }
  #{{ uid }} .bvhm__arrow:focus-visible { outline: 2px solid {{ s.text_color }}; outline-offset: 3px; }
  @media (max-width: 749px) {
    #{{ uid }} .bvhm__arrow { width: 38px; height: 38px; }
    #{{ uid }} .bvhm__arrow--prev { left: 8px; }
    #{{ uid }} .bvhm__arrow--next { right: 8px; }
  }
{%- endstyle -%}

<section id="{{ uid }}" class="bvhm">
  {%- if s.heading != blank -%}
    <h2 class="bvhm__heading">
      {%- if s.heading_icon_image != blank -%}
        <span class="bvhm__icon" aria-hidden="true">{{ s.heading_icon_image | image_url: width: 80 | image_tag: alt: '' }}</span>
      {%- elsif s.heading_icon != blank -%}
        <span class="bvhm__icon" aria-hidden="true">{{ s.heading_icon }}</span>
      {%- endif -%}
      {{ s.heading }}
    </h2>
  {%- endif -%}

  <bv-handmade-slider
    class="bvhm__slider"
    data-loop="{{ can_loop }}"
    data-autoplay="{{ s.autoplay }}"
    data-delay="{{ s.autoplay_delay | times: 1000 }}"
    data-depth="{{ s.depth }}"
    data-stretch="{{ s.stretch }}"
    data-start="{{ s.start_slide | minus: 1 }}"
  >
    <div class="swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide bvhm__slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="bvhm__media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: image_size: '900x', autoplay: true, muted: true, loop: true, playsinline: true }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 500px, 280px', alt: block.settings.image.alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.show_arrows -%}
      <button type="button" class="bvhm__arrow bvhm__arrow--prev" aria-label="Previous image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="bvhm__arrow bvhm__arrow--next" aria-label="Next image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    {%- endif -%}
  </bv-handmade-slider>
</section>

<script>
  window.bvLoadSwiper = window.bvLoadSwiper || function () {
    if (window.Swiper) return Promise.resolve(window.Swiper);
    if (!window.__bvSwiperPromise) {
      window.__bvSwiperPromise = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js';
        s.async = true;
        s.onload = function () { resolve(window.Swiper); };
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    return window.__bvSwiperPromise;
  };

  if (!customElements.get('bv-handmade-slider')) {
    customElements.define('bv-handmade-slider', class extends HTMLElement {
      connectedCallback() {
        this.onBlockSelect = this.onBlockSelect.bind(this);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        window.bvLoadSwiper().then((Swiper) => {
          if (!this.isConnected) return;
          const d = this.dataset;
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const total = this.querySelectorAll('.bvhm__slide').length;
          const start = Math.min(Math.max(parseInt(d.start, 10) || 0, 0), Math.max(total - 1, 0));
          this.swiper = new Swiper(this.querySelector('.swiper'), {
            effect: 'coverflow',
            centeredSlides: true,
            slidesPerView: 'auto',
            grabCursor: true,
            loop: d.loop === 'true',
            loopAdditionalSlides: 2,
            initialSlide: start,
            speed: 600,
            slideToClickedSlide: true,
            coverflowEffect: {
              rotate: 0,
              stretch: parseInt(d.stretch, 10),
              depth: parseInt(d.depth, 10),
              modifier: 1,
              slideShadows: false
            },
            autoplay: d.autoplay === 'true' && !reduceMotion
              ? { delay: parseInt(d.delay, 10), disableOnInteraction: false, pauseOnMouseEnter: true }
              : false,
            navigation: {
              nextEl: this.querySelector('.bvhm__arrow--next'),
              prevEl: this.querySelector('.bvhm__arrow--prev')
            },
            a11y: { enabled: true }
          });
        });
      }

      disconnectedCallback() {
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        if (this.swiper) this.swiper.destroy(true, true);
      }

      onBlockSelect(e) {
        if (!this.contains(e.target) || !this.swiper) return;
        const i = parseInt(e.target.dataset.index, 10);
        if (this.swiper.autoplay) this.swiper.autoplay.stop();
        if (this.swiper.params.loop) { this.swiper.slideToLoop(i); } else { this.swiper.slideTo(i); }
      }
    });
  }
</script>

{% schema %}
{
  "name": "BV Handmade slider",
  "tag": "div",
  "class": "bv-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_icon", "label": "Icon / emoji", "default": "❤️" },
    { "type": "image_picker", "id": "heading_icon_image", "label": "Or icon image", "info": "Replaces the emoji when set." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handmade With Love" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 20 },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "heading_gap", "label": "Space below heading (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_gap_mobile", "label": "Space below heading (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "header", "content": "Slider" },
    { "type": "range", "id": "slide_width", "label": "Slide width (desktop)", "min": 240, "max": 700, "step": 10, "unit": "px", "default": 480 },
    { "type": "range", "id": "slide_width_mobile", "label": "Slide width (mobile)", "min": 160, "max": 360, "step": 10, "unit": "px", "default": 250 },
    {
      "type": "select", "id": "aspect_ratio", "label": "Image shape", "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "2 / 3", "label": "Portrait (2:3)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ]
    },
    { "type": "range", "id": "depth", "label": "Side slide depth", "min": 0, "max": 500, "step": 10, "default": 200, "info": "Higher makes side slides smaller." },
    { "type": "range", "id": "stretch", "label": "Slide overlap", "min": -100, "max": 200, "step": 10, "unit": "px", "default": 40, "info": "Higher pulls side slides closer together." },
    { "type": "range", "id": "dim_sides", "label": "Fade side slides", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
    { "type": "range", "id": "start_slide", "label": "Start on slide number", "min": 1, "max": 20, "step": 1, "default": 3 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "shadow", "label": "Shadow strength", "min": 0, "max": 40, "step": 2, "unit": "%", "default": 10 },
    { "type": "checkbox", "id": "loop", "label": "Loop slides", "info": "Needs 5 or more slides.", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_delay", "label": "Autoplay delay", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "arrow_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_color", "label": "Arrow icon", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Or short video (plays muted on loop)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BV Handmade slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
