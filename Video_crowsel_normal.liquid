{%- comment -%}
  BV Video Carousel — "Join Our Community" UGC video slider (Swiper)
  Place in: sections/bv-video-carousel.liquid
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign uid = 'bvvc-' | append: section.id
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.css">

{%- style -%}
  #{{ uid }} {
    --bvvc-text: {{ s.text_color }};
    --bvvc-radius: {{ s.radius }}px;
    --bvvc-ratio: {{ s.aspect_ratio }};
    --bvvc-side: {{ s.side_padding }}px;
    background: {{ s.bg_color }};
    color: var(--bvvc-text);
    padding: {{ s.pad_top_mobile }}px 0 {{ s.pad_bottom_mobile }}px;
  }
  @media (min-width: 750px) {
    #{{ uid }} { padding: {{ s.pad_top }}px 0 {{ s.pad_bottom }}px; }
  }
  #{{ uid }} .bvvc__container {
    margin: 0 auto;
    padding: 0 16px;
    {% if s.container == 'boxed' %}max-width: {{ s.max_width }}px;{% endif %}
  }
  @media (min-width: 750px) {
    #{{ uid }} .bvvc__container { padding: 0 var(--bvvc-side); }
  }
  #{{ uid }} .bvvc__heading {
    margin: 0 0 24px;
    font-size: {{ s.heading_size_mobile }}px;
    line-height: 1.3;
    font-weight: 400;
    text-align: {{ s.heading_align }};
    color: var(--bvvc-text);
    letter-spacing: .02em;
  }
  @media (min-width: 750px) {
    #{{ uid }} .bvvc__heading { font-size: {{ s.heading_size }}px; margin-bottom: 28px; }
  }
  #{{ uid }} .bvvc__icon { margin-right: 8px; }
  #{{ uid }} .bvvc__slider { position: relative; }
  #{{ uid }} .swiper { overflow: hidden; }
  #{{ uid }} .bvvc__slide { height: auto; }
  #{{ uid }} .bvvc__media {
    position: relative;
    aspect-ratio: var(--bvvc-ratio);
    border-radius: var(--bvvc-radius);
    overflow: hidden;
    background: #eee;
  }
  #{{ uid }} .bvvc__media video,
  #{{ uid }} .bvvc__media img,
  #{{ uid }} .bvvc__media .bvvc__placeholder {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  #{{ uid }} .bvvc__poster { z-index: 1; transition: opacity .25s; }
  #{{ uid }} .is-playing .bvvc__poster,
  #{{ uid }}[data-preview="true"] .bvvc__poster { opacity: 0; pointer-events: none; }
  #{{ uid }} .bvvc__play {
    position: absolute; z-index: 2;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: {{ s.play_size }}px; height: {{ s.play_size }}px;
    border-radius: 50%;
    border: 0; padding: 0; cursor: pointer;
    background: rgba(255, 255, 255, .45);
    backdrop-filter: blur(2px);
    display: flex; align-items: center; justify-content: center;
    transition: transform .2s, opacity .2s, background .2s;
  }
  #{{ uid }} .bvvc__play:hover { background: rgba(255, 255, 255, .65); transform: translate(-50%, -50%) scale(1.06); }
  #{{ uid }} .bvvc__play svg { width: 38%; height: 38%; margin-left: 8%; fill: #fff; }
  #{{ uid }} .is-playing .bvvc__play { opacity: 0; pointer-events: none; }
  #{{ uid }} .bvvc__arrow {
    position: absolute; z-index: 5; top: 50%;
    transform: translateY(-50%);
    width: 48px; height: 48px;
    border-radius: 50%; border: 0; cursor: pointer;
    background: {{ s.arrow_bg }}; color: {{ s.arrow_color }};
    box-shadow: 0 2px 10px rgba(0, 0, 0, .18);
    display: flex; align-items: center; justify-content: center;
  }
  #{{ uid }} .bvvc__arrow svg { width: 18px; height: 18px; }
  #{{ uid }} .bvvc__arrow--prev { left: 10px; }
  #{{ uid }} .bvvc__arrow--next { right: 10px; }
  #{{ uid }} .bvvc__arrow.swiper-button-disabled { opacity: .35; cursor: default; }
  #{{ uid }} .bvvc__arrow:focus-visible,
  #{{ uid }} .bvvc__play:focus-visible { outline: 2px solid {{ s.text_color }}; outline-offset: 3px; }
  @media (max-width: 749px) {
    #{{ uid }} .bvvc__arrow { width: 38px; height: 38px; }
  }
{%- endstyle -%}

<section id="{{ uid }}" class="bvvc" data-preview="{{ s.preview_autoplay }}">
  <div class="bvvc__container">
    {%- if s.heading != blank -%}
      <h2 class="bvvc__heading">
        {%- if s.heading_icon != blank -%}<span class="bvvc__icon" aria-hidden="true">{{ s.heading_icon }}</span>{%- endif -%}
        {{ s.heading }}
      </h2>
    {%- endif -%}

    <bv-video-carousel
      class="bvvc__slider"
      data-desktop="{{ s.per_view_desktop }}"
      data-tablet="{{ s.per_view_tablet }}"
      data-mobile="{{ s.per_view_mobile }}"
      data-gap="{{ s.gap }}"
      data-gap-mobile="{{ s.gap_mobile }}"
      data-loop="{{ s.loop }}"
      data-preview="{{ s.preview_autoplay }}"
    >
      <div class="swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide bvvc__slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="bvvc__media">
                {%- liquid
                  assign has_video = false
                  if block.settings.video != blank or block.settings.video_url != blank
                    assign has_video = true
                  endif
                -%}

                {%- if block.settings.video != blank -%}
                  {%- if s.preview_autoplay -%}
                    {{ block.settings.video | video_tag: image_size: '900x', playsinline: true, preload: 'metadata', loop: true, muted: true, autoplay: true, class: 'bvvc__video' }}
                  {%- else -%}
                    {{ block.settings.video | video_tag: image_size: '900x', playsinline: true, preload: 'metadata', class: 'bvvc__video' }}
                  {%- endif -%}
                {%- elsif block.settings.video_url != blank -%}
                  <video
                    class="bvvc__video"
                    src="{{ block.settings.video_url }}"
                    playsinline
                    preload="metadata"
                    {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 900 }}"{% endif %}
                    {% if s.preview_autoplay %}autoplay muted loop{% endif %}
                  ></video>
                {%- endif -%}

                {%- if block.settings.poster != blank -%}
                  {{ block.settings.poster | image_url: width: 900 | image_tag: class: 'bvvc__poster', loading: 'lazy', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 40vw, 80vw', alt: block.settings.poster.alt }}
                {%- elsif has_video == false -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'bvvc__placeholder' }}
                {%- endif -%}

                {%- if has_video -%}
                  <button type="button" class="bvvc__play" aria-label="{{ 'Play video' }} {{ forloop.index }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4l15 8-15 8z"/></svg>
                  </button>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if s.show_arrows -%}
        <button type="button" class="bvvc__arrow bvvc__arrow--prev" aria-label="Previous slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="bvvc__arrow bvvc__arrow--next" aria-label="Next slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      {%- endif -%}
    </bv-video-carousel>
  </div>
</section>

<script>
  window.bvLoadSwiper = window.bvLoadSwiper || function () {
    if (window.Swiper) return Promise.resolve(window.Swiper);
    if (!window.__bvSwiperPromise) {
      window.__bvSwiperPromise = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js';
        s.async = true;
        s.onload = function () { resolve(window.Swiper); };
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    return window.__bvSwiperPromise;
  };

  if (!customElements.get('bv-video-carousel')) {
    customElements.define('bv-video-carousel', class extends HTMLElement {
      connectedCallback() {
        this.onClick = this.onClick.bind(this);
        this.onBlockSelect = this.onBlockSelect.bind(this);
        this.addEventListener('click', this.onClick);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        window.bvLoadSwiper().then((Swiper) => {
          if (!this.isConnected) return;
          const d = this.dataset;
          this.swiper = new Swiper(this.querySelector('.swiper'), {
            slidesPerView: parseFloat(d.mobile),
            spaceBetween: parseInt(d.gapMobile, 10),
            loop: d.loop === 'true',
            speed: 500,
            watchOverflow: true,
            navigation: {
              nextEl: this.querySelector('.bvvc__arrow--next'),
              prevEl: this.querySelector('.bvvc__arrow--prev')
            },
            breakpoints: {
              750: { slidesPerView: parseFloat(d.tablet), spaceBetween: parseInt(d.gap, 10) },
              1100: { slidesPerView: parseFloat(d.desktop), spaceBetween: parseInt(d.gap, 10) }
            }
          });
        });
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
        if (this.swiper) this.swiper.destroy(true, true);
      }

      onClick(e) {
        const btn = e.target.closest('.bvvc__play');
        if (!btn) return;
        const slide = btn.closest('.bvvc__slide');
        const video = slide.querySelector('video');
        if (!video) return;
        this.stopOthers(video);
        if (this.dataset.preview === 'true') video.currentTime = 0;
        video.muted = false;
        video.controls = true;
        slide.classList.add('is-playing');
        const p = video.play();
        if (p && p.catch) p.catch(function () {});
        video.addEventListener('ended', () => {
          slide.classList.remove('is-playing');
          video.controls = false;
        }, { once: true });
      }

      stopOthers(except) {
        this.querySelectorAll('.bvvc__slide.is-playing').forEach((slide) => {
          const v = slide.querySelector('video');
          if (!v || v === except) return;
          v.controls = false;
          if (this.dataset.preview === 'true') { v.muted = true; } else { v.pause(); }
          slide.classList.remove('is-playing');
        });
      }

      onBlockSelect(e) {
        if (!this.contains(e.target) || !this.swiper) return;
        const i = parseInt(e.target.dataset.index, 10);
        if (this.swiper.params.loop) { this.swiper.slideToLoop(i); } else { this.swiper.slideTo(i); }
      }
    });
  }
</script>

{% schema %}
{
  "name": "BV Video carousel",
  "tag": "div",
  "class": "bv-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_icon", "label": "Icon / emoji", "default": "✨" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Community of 100,000+ Happy Customers!" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 18 },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Slider" },
    { "type": "range", "id": "per_view_desktop", "label": "Videos visible (desktop)", "min": 1, "max": 6, "step": 0.5, "default": 4 },
    { "type": "range", "id": "per_view_tablet", "label": "Videos visible (tablet)", "min": 1, "max": 4, "step": 0.5, "default": 2.5 },
    { "type": "range", "id": "per_view_mobile", "label": "Videos visible (mobile)", "min": 1, "max": 3, "step": 0.1, "default": 1.3 },
    { "type": "range", "id": "gap", "label": "Gap (desktop)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "gap_mobile", "label": "Gap (mobile)", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 12 },
    {
      "type": "select", "id": "aspect_ratio", "label": "Video shape", "default": "11 / 16",
      "options": [
        { "value": "9 / 16", "label": "Story (9:16)" },
        { "value": "11 / 16", "label": "Tall (11:16)" },
        { "value": "2 / 3", "label": "Portrait (2:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square" }
      ]
    },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "play_size", "label": "Play button size", "min": 32, "max": 90, "step": 2, "unit": "px", "default": 50 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop slides", "default": false },
    { "type": "checkbox", "id": "preview_autoplay", "label": "Autoplay muted previews", "info": "Videos play silently in a loop. Tapping play restarts with sound.", "default": false },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "container", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "boxed", "label": "Boxed" }
      ]
    },
    { "type": "range", "id": "max_width", "label": "Max width (boxed)", "min": 800, "max": 2000, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "side_padding", "label": "Side padding (desktop)", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 45 },
    { "type": "range", "id": "pad_top", "label": "Top padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "arrow_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_color", "label": "Arrow icon", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "limit": 30,
      "settings": [
        { "type": "video", "id": "video", "label": "Video (Shopify upload)" },
        { "type": "url", "id": "video_url", "label": "Or MP4 file URL", "info": "Used only when no video is uploaded above." },
        { "type": "image_picker", "id": "poster", "label": "Cover image (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BV Video carousel",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
